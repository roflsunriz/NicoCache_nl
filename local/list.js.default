// このファイルは編集・削除しないでください
// カスタマイズする際は、list.jsにmakeCacheList関数を持った
// スクリプトを作成してください。
// cssが必要な場合は、list.cssという名前が利用できます。

"use strict";

function makeCacheList() {
  const getSmid = (value) => /^\w{2}\d+/.exec(value)?.[0] ?? "";

  const temporaryItems = Object.entries(globalThis.tempList ?? {}).map(
    ([id, [title, downloaded, totalSize, downloading]]) => {
      const percent = totalSize > 1
        ? Math.trunc((downloaded / totalSize) * 100)
        : "";
      const status = downloading
        ? `[DL中 (${percent}%)] `
        : `[一時][<a href="./rmtmp?${id}">削除</a>] `;

      return `<li>[<a href="../watch/${getSmid(id)}">再生</a>]${status}`
        + `<span style="width:100px;">${id}</span>[${title}] ${downloaded} bytes</li>`;
    },
  );

  const cachedItems = Object.entries(globalThis.cacheList ?? {}).map(
    ([id, [title]]) => {
      const displayTitle = title !== ""
        ? title
        : `(<a href="title?${id}" style="color:red;">タイトルを取得</a>)`;

      return `<li>[<a href="../watch/${getSmid(id)}">再生</a>]`
        + `[<a href="./${id}/movie">保存</a>]`
        + `[<a href="./${id}/audio">音声</a>]`
        + `[<a href="./rm?${id}">削除</a>] `
        + `<span style="width:100px;">${id}</span>[${displayTitle}]</li>`;
    },
  );

  const sections = [];
  if (temporaryItems.length > 0) {
    sections.push(`<li>一時ファイル<ul>${temporaryItems.join("")}</ul></li>`);
  }
  sections.push(cachedItems.length > 0
    ? `<li>キャッシュファイル<ul>${cachedItems.join("")}</ul></li>`
    : "<li>キャッシュはまだありません。</li>");

  document.body.insertAdjacentHTML(
    "beforeend",
    `<a href="http://www.nicovideo.jp/">トップに戻る</a>。 `
      + `${globalThis.ncversion} powered by `
      + `<a href="http://nicolist.net/">nicolist.net</a><ul>${sections.join("")}</ul>`,
  );
}
